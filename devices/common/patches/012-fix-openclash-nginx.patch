From 85a4dcf8c14ab18848e7da546480a1db3a3769f7 Mon Sep 17 00:00:00 2001
From: miaogongzi <miaogongzi0227@gmail.com>
Date: Fri, 21 Aug 2026 05:17:36 +0800
Subject: [PATCH] Add nginx configuration for OpenClash

---
 luci-app-openclash/root/etc/uci-defaults/luci-openclash | 1 -
 1 file changed, 1 deletion(-)

diff --git a/luci-app-openclash/root/etc/uci-defaults/luci-openclash b/luci-app-openclash/root/etc/uci-defaults/luci-openclash
index c2bd1ed497..fd3b6a4114 100644
--- a/feeds/miaogongzi/luci-app-openclash/root/etc/uci-defaults/luci-openclash
+++ b/feeds/miaogongzi/luci-app-openclash/root/etc/uci-defaults/luci-openclash
@@ -222,7 +222,6 @@ fi
 #nginx backend (luci-nginx, newer LuCI): conf.d/*.conf is merged into the http block
 if [ -d /etc/nginx/conf.d ]; then
 	cat > /etc/nginx/conf.d/openclash.conf <<-EOF
-client_max_body_size 10m;
 uwsgi_read_timeout 3600;
 proxy_read_timeout 3600;
 EOF
