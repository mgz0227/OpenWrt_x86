--- a/feeds/luci/luci.mk
+++ b/feeds/luci/luci.mk
@@ -92,7 +92,7 @@ define findrev
       set -- $$(git log -1 --format="%ct %h" --abbrev=7 -- $(if $(1),. ':(exclude)po',po)); \
       if [ -n "$$1" ]; then
         secs="$$(($$1 % 86400))"; \
